# Local-only development admin wallet — TEMPLATE.
#
# Copy this file to `config/dev-wallet.env` (which is gitignored) and fill in a
# mnemonic you generate LOCALLY. Never commit a real mnemonic: scripts/oss-preflight.sh
# blocks *-wallet.env paths and mnemonic-shaped content on push.
#
# Generate a fresh dev wallet with:
#   ./sdn-server/spacedatanetwork identity new    # prints mnemonic + xpub
#
# Do NOT reuse this wallet for real funds, identities, or production admin.
# For production, provision the admin xpub out-of-band (secret manager) and add
# it to the live auth store; do not ship a mnemonic file to servers.

SDN_TRACKED_DEV_ADMIN_NAME=local-dev-admin
SDN_TRACKED_DEV_ADMIN_ACCOUNT_PATH=m/44'/0'/0'
SDN_TRACKED_DEV_ADMIN_MNEMONIC=REPLACE_WITH_YOUR_LOCAL_DEV_MNEMONIC
SDN_TRACKED_DEV_ADMIN_XPUB=REPLACE_WITH_XPUB
SDN_TRACKED_DEV_ADMIN_SIGNING_PUBKEY_HEX=REPLACE_WITH_SIGNING_PUBKEY_HEX
