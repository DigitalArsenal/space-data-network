// Node-internal publication persistence and replay metadata. SDS payloads stay
// in size-prefixed record streams. Generated by build-publication-schema.mjs.
namespace pst;

table SourceTags {
  provider_id:string; source_name:string; source_url:string; batch_id:string;
  content_key_id:string; producer_peer_id:string; producer_public_key:string;
  license:string; license_url:string; citation:string; share_alike:bool;
}
table RetainedSource {
  schema:string; provider:string; source:string; product_source:string;
  catalog_object_limit:int;
}
table SourceList { sources:[RetainedSource]; }
table Refusal { index:int; code:int; }
table Outcome { refused:[Refusal]; }
table JournalEntry {
  digest:string; sequence:ulong; source_sequence:ulong; schema:string;
  tags:SourceTags; peer:string; signature:[ubyte]; identity:bool; own_ts:bool;
  applied:bool; refused:[Refusal];
}
table SourceSequence { id:string; sequence:ulong; }
table Watermarks { global:ulong; sources:[SourceSequence]; }
table Failure { attempts:int; reason:string; retry_at:string; }
table SequenceList { sequences:[ulong]; }
table Exclusion { cid:string; excluded:bool; }
table Exclusions { entries:[Exclusion]; }
table Notice { key:string; reason:string; }
table NoticeList { entries:[Notice]; }
table Reclamation { high_water:ulong; reclaimed:ulong; pending:[ulong]; }
table IndexRecord {
  cid:string; offset:long; length:long;
  norad_cat_id:uint = null; entity_id:string; object_type:string;
  ops_status_code:string; epoch_unix:long = null; epoch_day:string; tags:SourceTags;
}
table IndexGroup { key:string; rows:[int]; }
table MaterializedIndexes {
  by_norad:[IndexGroup]; by_entity_id:[IndexGroup]; by_object_type:[IndexGroup];
  by_ops_status_code:[IndexGroup]; ca_ready_resident:[int]; active_payloads:[int];
}
table ExportIndex {
  publication_cutoff:ulong; publication_source_cutoff:ulong;
  publication_source_sequences:[ulong]; version:int;
  schema_name:string; provider_id:string; source_name:string; batch_id:string;
  query_sha256:string; result_sha256:string; shard_sha256:string; shard_cid:string;
  shard_file:string; record_count:int; records:[IndexRecord]; indexes:MaterializedIndexes;
}
table BatchAction { schema:string; provider:string; source:string; batch:string; action:string; }
union Body {
  JournalEntry, SourceList, Outcome, Watermarks, Failure, SequenceList,
  Exclusions, SourceTags, NoticeList, Reclamation, ExportIndex, BatchAction
}
// Checksum is SHA-256 of the whole size-prefixed buffer with these 32 bytes zero.
table PublicationState { version:ushort = 1; payload:Body; checksum:[ubyte]; }
root_type PublicationState;
file_identifier "$PST";
