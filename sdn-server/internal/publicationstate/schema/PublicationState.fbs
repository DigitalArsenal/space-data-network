// Node-internal publication persistence and replay metadata. SDS payloads stay
// in size-prefixed record streams. Generated by build-publication-schema.mjs.
namespace pst;

table SourceTags {
  ProviderID:string; SourceName:string; SourceURL:string; BatchID:string;
  ContentKeyID:string; ProducerPeerID:string; ProducerPublicKey:string;
  License:string; LicenseURL:string; Citation:string; ShareAlike:bool;
}
table RetainedSource {
  Schema:string; Provider:string; Source:string; ProductSource:string;
  CatalogObjectLimit:int;
}
table SourceList { Sources:[RetainedSource]; }
table Refusal { Index:int; Code:int; }
table Outcome { Refused:[Refusal]; }
table JournalEntry {
  Digest:string; Sequence:ulong; SourceSequence:ulong; Schema:string;
  Tags:SourceTags; Peer:string; Signature:[ubyte]; Identity:bool; OwnTS:bool;
  Applied:bool; Refused:[Refusal];
}
table SourceSequence { ID:string; Sequence:ulong; }
table Watermarks { Global:ulong; Sources:[SourceSequence]; }
table Failure { Attempts:int; Reason:string; RetryAt:string; }
table SequenceList { Sequences:[ulong]; }
table Exclusion { CID:string; Excluded:bool; }
table Exclusions { Entries:[Exclusion]; }
table Notice { Key:string; Reason:string; }
table NoticeList { Entries:[Notice]; }
table Reclamation { HighWater:ulong; Reclaimed:ulong; Pending:[ulong]; }
table IndexRecord {
  CID:string; Offset:long; Length:long;
  NoradCatID:uint = null; EntityID:string; ObjectType:string;
  OpsStatusCode:string; EpochUnix:long = null; EpochDay:string; Tags:SourceTags;
}
table IndexGroup { Key:string; Rows:[int]; }
table MaterializedIndexes {
  ByNORAD:[IndexGroup]; ByEntityID:[IndexGroup]; ByObjectType:[IndexGroup];
  ByOpsStatusCode:[IndexGroup]; CAReadyResident:[int]; ActivePayloads:[int];
}
table ExportIndex {
  PublicationCutoff:ulong; PublicationSourceCutoff:ulong;
  PublicationSourceSequences:[ulong]; Version:int;
  SchemaName:string; ProviderID:string; SourceName:string; BatchID:string;
  QuerySHA256:string; ResultSHA256:string; ShardSHA256:string; ShardCID:string;
  ShardFile:string; RecordCount:int; Records:[IndexRecord]; Indexes:MaterializedIndexes;
}
table BatchAction { Schema:string; Provider:string; Source:string; Batch:string; Action:string; }
union Body {
  JournalEntry, SourceList, Outcome, Watermarks, Failure, SequenceList,
  Exclusions, SourceTags, NoticeList, Reclamation, ExportIndex, BatchAction
}
// Checksum is SHA-256 of the whole size-prefixed buffer with these 32 bytes zero.
table PublicationState { Version:ushort = 1; Payload:Body; Checksum:[ubyte]; }
root_type PublicationState;
file_identifier "$PST";
