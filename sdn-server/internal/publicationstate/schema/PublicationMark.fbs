// Node-internal mark of a running or refused dataset publication. Generated by
// build-publication-schema.mjs. It is kept out of PublicationState.fbs: the
// manifest of a publication names that file's SHA-256 for its index, and a
// receiver rebuilds the signed manifest with its own copy, so any edit of that
// file stops every node on another copy from verifying this node's
// publications.
namespace pmk;

// started is when the publication was first requested (Unix nanoseconds);
// attempts is how many attempts to publish it again were started after the
// process that ran it ended.
table PublicationMark {
  schema:string; provider:string; source:string; batch:string; action:string;
  started:long; attempts:int;
}
root_type PublicationMark;
file_identifier "$PMK";
