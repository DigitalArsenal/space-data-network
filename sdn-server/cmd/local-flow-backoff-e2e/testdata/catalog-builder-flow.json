      "methodId": "run_chain",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "fallback",
      "pluginId": "com.digitalarsenal.flows.catalog-builder.chain",
      "methodId": "ingest_seed",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "annotation",
      "pluginId": "com.digitalarsenal.analysis.gp-error-model",
      "methodId": "annotate_population_flow",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "finalizer",
      "pluginId": "com.spacedatanetwork.sdn-ap-propagator",
      "methodId": "preseed_catalog",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "composer",
      "pluginId": "com.digitalarsenal.analysis.catalog-composer",
      "methodId": "replace_products",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "ingest",
      "pluginId": "com.digitalarsenal.hostcap.storage-ingest",
      "methodId": "ingest",
      "kind": "transform",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "egress",
      "pluginId": "sdn.flow.egress",
      "methodId": "emit",
      "kind": "sink",
      "drainPolicy": "single-shot"
    },
    {
      "nodeId": "product-prepare",
      "pluginId": "com.digitalarsenal.flows.catalog-builder.control",
      "methodId": "prepare_products",
      "kind": "transform"
    },
    {
      "nodeId": "product-compose",
