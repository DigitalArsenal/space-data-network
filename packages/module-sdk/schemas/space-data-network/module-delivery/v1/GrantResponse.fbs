include "BundleDescriptor.fbs";
include "WrappedContentKey.fbs";

namespace space_data_network.module_delivery.v1;

// Provider -> requester grant result plus encrypted bundle metadata.
table GrantResponse {
  schema_version:uint = 1;
  req_id:string (required);
  entitlement_status:string;
  capability_token:string;
  expires_at_ms:ulong;
  granted_domain:string (required);
  granted_timeout_ms:ulong;
  grant_signature:[ubyte];
  grant_verifier_public_key:[ubyte];
  bundle_descriptor:BundleDescriptor (required);
  wrapped_content_key:WrappedContentKey (required);
}

root_type GrantResponse;
file_identifier "SDGS";
