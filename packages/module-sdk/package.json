{
  "name": "@spacedatanetwork/module-sdk",
  "version": "2.0.0",
  "description": "Module delivery v1 contracts and protocol tooling for Space Data Network",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./module-delivery-codec": "./src/module-delivery-codec.js",
    "./key-broker-codec": "./src/key-broker-codec.js",
    "./third-party-codec": "./src/third-party-codec.js"
  },
  "scripts": {
    "generate:module-delivery-bindings": "node scripts/generate-module-delivery-bindings.mjs",
    "generate:module-delivery-fixtures": "node scripts/generate-module-delivery-fixtures.mjs",
    "generate:all-bindings": "npm run generate:module-delivery-bindings && npm run generate:module-delivery-fixtures",
    "test:module-delivery": "node scripts/module-delivery-test-client.mjs && node tests/conformance/run-conformance.mjs",
    "test:conformance": "node tests/conformance/run-conformance.mjs",
    "test:module-delivery-client": "node scripts/module-delivery-test-client.mjs",
    "internal:generate:key-broker-bindings": "node scripts/generate-key-broker-bindings.mjs",
    "internal:generate:third-party-bindings": "node scripts/generate-third-party-bindings.mjs",
    "internal:generate:third-party-fixtures": "node scripts/generate-third-party-fixtures.mjs",
    "internal:scaffold:third-party-client": "node scripts/generate-third-party-scaffold.mjs --type client",
    "internal:scaffold:third-party-server": "node scripts/generate-third-party-scaffold.mjs --type server",
    "internal:test:key-broker-client": "node scripts/key-broker-test-client.mjs"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^16.1.0",
    "@chainsafe/libp2p-yamux": "^7.0.4",
    "@libp2p/tcp": "^10.1.12",
    "@libp2p/websockets": "^9.2.0",
    "@multiformats/multiaddr": "^12.3.5",
    "flatbuffers": "^25.9.23",
    "libp2p": "^2.6.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "flatc-wasm": "^25.12.19-wasm.43"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "schemas",
    "src",
    "fixtures",
    "templates",
    "tests",
    "scripts",
    "README.md",
    "scripts/key-broker-test-client.mjs",
    "scripts/module-delivery-test-client.mjs"
  ]
}
