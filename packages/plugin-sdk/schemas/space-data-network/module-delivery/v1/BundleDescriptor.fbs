namespace space_data_network.module_delivery.v1;

// Metadata required to fetch and instantiate the encrypted module bundle.
table BundleDescriptor {
  schema_version:uint = 1;
  cid:string (required);
  content_hash:[ubyte] (required);
  size_bytes:ulong;
  module_id:string (required);
  module_version:string;
  runtime:string;
  abi:string;
  entrypoint:string;
  publication_cid:string;
  content_codec:string;
  encryption_codec:string;
}

root_type BundleDescriptor;
file_identifier "SDBD";
