namespace space_data_network.module_delivery.v1;

// Wrapped content key metadata for the requester-side wasm decrypt path.
table WrappedContentKey {
  schema_version:uint = 1;
  wrapping_algorithm:string (required);
  recipient_key_id:string;
  recipient_public_key:[ubyte];
  ephemeral_public_key:[ubyte] (required);
  nonce:[ubyte] (required);
  ciphertext:[ubyte] (required);
  tag:[ubyte];
}

root_type WrappedContentKey;
file_identifier "SDWK";
