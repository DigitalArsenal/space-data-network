{
  "name": "space-data-network-desktop",
  "private": true,
  "version": "1.0.5-beta.1",
  "productName": "Space Data Network",
  "description": "Runs a Space Data Network node and shows the node's own dashboard",
  "main": "src/index.js",
  "scripts": {
    "start": "cross-env NODE_ENV=development electron .",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "cross-env NODE_ENV=test playwright test \"test/unit/.*.spec.js\"",
    "stage-node": "node scripts/stage-node-bundle.mjs",
    "build:local": "bash scripts/build-local.sh",
    "postinstall": "electron-builder install-app-deps",
    "package": "shx rm -rf dist/ && electron-builder --publish never"
  },
  "keywords": [
    "space data network",
    "sdn",
    "node",
    "desktop"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/DigitalArsenal/space-data-network"
  },
  "author": "Space Data Network",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DigitalArsenal/space-data-network/issues/new/choose"
  },
  "homepage": "https://spacedatanetwork.org/downloads/",
  "devDependencies": {
    "@electron/notarize": "^1.2.3",
    "@playwright/test": "^1.50.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.0",
    "electron": "^39.2.4",
    "electron-builder": "26.0.11",
    "proxyquire": "^2.1.3",
    "shx": "0.3.4",
    "sinon": "^13.0.1",
    "standard": "16.0.4"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "fs-extra": "^10.0.1",
    "untildify": "^4.0.0",
    "v8-compile-cache": "^2.4.0",
    "winston": "^3.7.2"
  },
  "standard": {
    "ignore": [
      "**/*.ts",
      "assets/sdn-node/**",
      "dist/**"
    ]
  }
}
