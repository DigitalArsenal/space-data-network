[Unit]
Description=Space Data Network CelesTrak Ingestion Worker
Documentation=https://github.com/DigitalArsenal/space-data-network
After=network-online.target spacedatanetwork.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=sdn
Group=sdn

Environment=SDN_CONFIG=/etc/spacedatanetwork/config.yaml
Environment=SDN_STORAGE_PATH=/var/lib/spacedatanetwork/data
Environment=SDN_RAW_PATH=/var/lib/spacedatanetwork/raw
Environment=SDN_DATASET_PUBLISH_URL=http://127.0.0.1:5001/api/v1/admin/dataset-updates/publish
Environment=SPACETRACK_IDENTITY=
Environment=SPACETRACK_PASSWORD=
Environment=WASMEDGE_DIR=/opt/spacedatanetwork/.wasmedge

WorkingDirectory=/opt/spacedatanetwork

ExecStart=/opt/spacedatanetwork/bin/spacedatanetwork \
    --config ${SDN_CONFIG} \
    ingest \
    --storage-path ${SDN_STORAGE_PATH} \
    --raw-path ${SDN_RAW_PATH} \
    --celestrak-interval 3h \
    --satcat-interval 24h \
    --celestrak-space-weather-interval 3h \
    --dataset-publish-url ${SDN_DATASET_PUBLISH_URL} \
    --spacetrack-enabled=false \
    --http-timeout 120s

Restart=always
RestartSec=10

LimitNOFILE=65536
LimitNPROC=4096

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/spacedatanetwork

StandardOutput=journal
StandardError=journal
SyslogIdentifier=spacedatanetwork-ingest

[Install]
WantedBy=multi-user.target
