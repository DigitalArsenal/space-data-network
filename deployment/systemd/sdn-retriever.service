# sdn-retriever.service — the CelesTrak retriever/producer on host-02 (sfo2).
#
# OWNED BY: Hephaestus (unit, ports, enrolment). Hermes owns the flow runtime and
# the daemon's config/identity. Migrated from host-01 on 2026-07-28 by owner
# ruling: "the celestrak.eth box is for the celestrak shit, the sdn.spaceaware.io
# is for serving the encrypted modules." The host-01-flavored unit this file used
# to hold (paths under /mnt/volume_nyc3_01, ports 4003/5003, Nice/CPUWeight
# tuned to share the box with the sidecar) never actually ran there — the role
# was migrated to host-02 before cutover. This is now the one canonical unit,
# adopted from Hermes-3's live-staged host-02 copy 2026-07-28, with the systemd
# Conflicts= belt restored (present on the retired host-01 draft, absent from
# the staged copy) and updated to name host-02's actual retired units.
#
# ONE NODE PER BOX (owner law, 2026-07-28). The legacy kubo.service and
# sdn-kubo.service on this host were escrowed, stopped and disabled so this can
# be the only SDN daemon here. The daemon enforces the same rule itself and will
# refuse to start if another one appears; Conflicts= below is the systemd-level
# belt, and deployment/lib/sdn-preflight-single-instance.sh is the deploy-time
# check every install path runs before touching this host.
#
# ############################################################################
# # DO NOT ADD Environment=IPFS_PATH TO THIS UNIT. EVER.                     #
# ############################################################################
# sdn-server calls EnsureManagedIPFSRepoIdentity unconditionally whenever
# IPFS_PATH is set and rewrites Identity.PrivKey IN PLACE. Pointing this unit at
# a kubo repo would destroy that repo's peer identity, and the key types are
# incompatible anyway (secp256k1 HD-derived here, Ed25519 there).
#
# HARDWARE (was 1 vCPU / 2 GB; OWNER RESIZED 2026-08-05, live-re-verified by
# Hephaestus/Bohr the same day — kernel reports 4 vCPU / 7.8 GiB / 154 GiB disk,
# see deployment/topology.json cluster["celestrak.eth"].post_resize_census_20260805).
# The MemoryHigh/MemoryMax below are updated to match (ops-host02-topology-
# refuted-memory-throttle); everything else in this unit is unchanged pending
# fresh pin/load evidence on the new shape. Owner law: prod does its own work
# and takes as long as it takes — duration is NOT a gate, so nothing here
# trades correctness for speed.
#
# PORTS
#   4001  libp2p, PUBLIC. Inherited from the kubo this box used to run, so it is
#         a port already proven reachable from the outside.
#   5003  admin, LOOPBACK ONLY — this daemon serves no public HTTP surface.
#
# DIAL DIRECTION: host-01's sidecar dials US. Its own libp2p listener is
# loopback-only, so it cannot be dialled back; see the config's bootstrap note.

[Unit]
Description=SDN CelesTrak retriever/producer (host-02, celestrak.eth box)
Documentation=https://github.com/DigitalArsenal/space-data-network/blob/main/deployment/systemd/sdn-retriever.service
After=network-online.target
Wants=network-online.target

# ONE BOX, ONE NODE — owner law 2026-07-28, verbatim: "never ever have more than
# one instance running on a box from here on out with our current deployment."
#
# Conflicts= is the systemd-level belt for the deploy scripts' braces: starting
# this unit STOPS the others rather than joining them, and systemd enforces it
# even when a human runs `systemctl start` by hand, or on a boot race where two
# units are both enabled. The scripts refuse to install a second instance; this
# guarantees that even if two unit files coexist on a box, only one ever runs.
Conflicts=kubo.service sdn-kubo.service spacedatanetwork.service

[Service]
Type=simple
# Identity + at-rest key password are fed by file, never by environment. The
# file is what makes this identity portable between machines.
Environment=SDN_KEY_PASSWORD_FILE=/etc/spacedatanetwork/retriever/key_password
Environment=WASMEDGE_DIR=/opt/sdn-retriever/.wasmedge
Environment=LD_LIBRARY_PATH=/opt/sdn-retriever/.wasmedge/lib
# A persistent, writable AOT cache. Without this the daemon resolves a
# PrivateTmp path that is wiped on every restart, and every flow runs
# INTERPRETED forever — which on this box is the difference between a SATCAT
# parse finishing and a SATCAT parse never finishing.
Environment=XDG_CACHE_HOME=/var/lib/sdn-retriever/cache
# Deliberately ABSENT: IPFS_PATH. See the banner above.
ExecStart=/opt/sdn-retriever/spacedatanetwork daemon --config /etc/spacedatanetwork/retriever/config.yaml
# Restart=always, NOT on-failure, and this is load-bearing for the UPDATE LANE.
# The lane applies an update by asking the daemon to shut down GRACEFULLY
# (main.go:2551 "Update shutdown requested"), which exits ZERO. It then reports
# `restart=supervised` / "the supervising init restarts the daemon under its own
# unit" and waits on the admin health endpoint. Under Restart=on-failure systemd
# treats exit 0 as success and never restarts, so that health check is
# UNSATISFIABLE: every `update install` on this unit must time out, roll back,
# and leave the box DARK until a human runs `systemctl start`.
# Measured on host-02 2026-08-08: daemon stopped 06:54:18, health probe refused on
# 127.0.0.1:5003 for the whole window, rollback to fa9c8d5f at 07:04:16, ingest
# down 14m05s. host-01's delivery unit was already Restart=always, which is the
# only reason the identical roll succeeded there.
Restart=always
RestartSec=15
LimitNOFILE=65536

# The ingest holds a whole fetched catalog, its base64 hostcall envelope, every
# normalized record stream and the raw archive copy in ONE linear memory. A
# SATCAT run measured ~670MB RSS on host-01; on THIS box, three concurrent
# lanes were observed pinned at MemoryCurrent ~1.54G against the old 1.2G/1.6G
# caps sized for the 1-vCPU/2GB shape (permanent memory.high throttle, swap
# exhausted) — that shape no longer exists (post-resize: 4 vCPU / 7.8 GiB).
# Resized 2026-08-05 (ops-host02-topology-refuted-memory-throttle): ceiling
# raised to leave ~1.8G headroom on the box for the OS + ipfs.service
# (MemoryMax=640M, untouched) + swap backstop, not maxing the box out.
MemoryHigh=4200M
MemoryMax=5800M

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/sdn-retriever /etc/spacedatanetwork/retriever

[Install]
WantedBy=multi-user.target
