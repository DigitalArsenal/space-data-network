{
  "name": "@spacedatanetwork/sdn-js",
  "version": "2.0.12",
  "description": "Space Data Network JavaScript library for browser and Node.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.mjs"
    },
    "./storefront": {
      "types": "./dist/storefront/index.d.ts",
      "import": "./dist/storefront/index.mjs"
    }
  },
  "files": [
    "dist",
    "wasm"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:ui",
    "build:package": "npm run build:core",
    "build:core": "rm -rf dist && tsc --project tsconfig.build.json --emitDeclarationOnly && node scripts/build-package-entry.mjs",
    "build:ui": "vite build --config ui/vite.config.mts",
    "build:sdn-ui": "vite build --config ui/vite.config.mts",
    "dev:sdn-ui": "vite --config ui/vite.config.mts",
    "check:sdn-ui": "svelte-check --tsconfig ui/tsconfig.json",
    "dev": "tsc --emitDeclarationOnly --watch",
    "test": "npm run build:core && vitest run",
    "test:e2e:storefront": "playwright test --config playwright.storefront.config.ts",
    "test:relay": "SDN_RUN_RELAY_TEST=1 vitest run src/spaceaware-relay.integration.test.ts",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build:package"
  },
  "keywords": [
    "space",
    "data",
    "network",
    "p2p",
    "libp2p",
    "flatbuffers",
    "ipfs"
  ],
  "author": "Space Data Network",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DigitalArsenal/space-data-network.git",
    "directory": "sdn-js"
  },
  "homepage": "https://github.com/DigitalArsenal/space-data-network/tree/main/sdn-js#readme",
  "bugs": {
    "url": "https://github.com/DigitalArsenal/space-data-network/issues"
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "^13.0.0",
    "@chainsafe/libp2p-noise": "^15.0.0",
    "@chainsafe/libp2p-yamux": "^6.0.0",
    "@helia/unixfs": "^7.1.0",
    "@libp2p/bootstrap": "^10.0.0",
    "@libp2p/circuit-relay-v2": "^1.0.0",
    "@libp2p/crypto": "^4.1.9",
    "@libp2p/identify": "^2.0.0",
    "@libp2p/interface": "^1.7.0",
    "@libp2p/kad-dht": "^12.0.0",
    "@libp2p/peer-id": "^4.2.4",
    "@libp2p/websockets": "^8.0.0",
    "@libp2p/webtransport": "^4.0.0",
    "@multiformats/multiaddr": "^12.1.0",
    "@noble/curves": "^1.9.7",
    "flatbuffers": "^25.9.23",
    "flatsql": "^0.4.2",
    "hd-wallet-ui": "^2.0.6",
    "hd-wallet-wasm": "^2.0.6",
    "helia": "^6.0.22",
    "idb": "^8.0.0",
    "libp2p": "^1.2.0",
    "monaco-editor": "^0.55.1",
    "multiformats": "^13.3.7",
    "qrcode": "^1.5.3",
    "space-data-module-sdk": "^0.8.4",
    "spacedatastandards.org": "^1.98.0",
    "uint8arraylist": "^2.4.8",
    "uint8arrays": "^5.0.0",
    "vcard-cryptoperson": "^1.1.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
